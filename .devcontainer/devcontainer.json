{
  "name": "ROS 2 Humble TSR",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "overrideCommand": false,
  "forwardPorts": [
    6080
  ],
  "portsAttributes": {
    "6080": {
      "label": "ROS GUI noVNC",
      "onAutoForward": "notify"
    }
  },
  "containerEnv": {
    "DISPLAY": ":1",
    "LIBGL_ALWAYS_SOFTWARE": "1",
    "QT_X11_NO_MITSHM": "1",
    "TURTLEBOT3_MODEL": "burger"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools",
        "ms-iot.vscode-ros"
      ]
    }
  }
}
